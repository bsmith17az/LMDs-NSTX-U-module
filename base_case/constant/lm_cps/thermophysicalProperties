FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

k                      85;
mixture
{
    specie
    {
        molWeight       6.94;
    }
    equationOfState
    {
        rho             534;
    }
    thermodynamics
    {
        Cp              3580;
        Hf              0;
    }
    transport
    {
        mu              0.13e-3;
        Pr              #eval "$mu * ${../thermodynamics/Cp} / $k";
    }
}


