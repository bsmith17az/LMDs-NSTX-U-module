FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/holder";
    object      cellToRegion;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    holder_bottom
    {
        type            zeroGradient;
    }
    holder_module_interface
    {
        type            zeroGradient;
    }
    holder_symmetry
    {
        type            symmetry;
    }
    holder_walls
    {
        type            zeroGradient;
    }
    holder_to_module
    {
        type            calculated;
        value           uniform 0;
    }
}


