FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    object      cellToRegion;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

TRef            300;
internalField   uniform $TRef;

boundaryField
{
    lm_cps_external
    {
        type            externalWallHeatFluxTemperature;
        mode            coefficient;
        h		        uniform 1000;	
        Ta		        constant $TRef;
        kappaMethod	    fluidThermo;
        value		    uniform $TRef;
    }
    ".*symmetry"
    {
        type            symmetry;
    }
    lm_cps_to_module
    {
        
        type            compressible::turbulentTemperatureRadCoupledMixed;
        kappaMethod	    fluidThermo;
    	Tnbr            T;
    	value           uniform $TRef;
    }
}


