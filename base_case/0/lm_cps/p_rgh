FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    object      cellToRegion;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

pRef            1e5;
internalField   uniform $pRef;

boundaryField
{
    ".*"
    {
        type            calculated;
        value           uniform $pRef;
    }
    ".*symmetry"
    {
        type            symmetryPlane;
    }
}


