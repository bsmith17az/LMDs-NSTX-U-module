FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    object      cellToRegion;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

tRef            300;
internalField   uniform $tRef;

boundaryField
{
    holder_bottom
    {
        type            zeroGradient;
    }
    holder_symmetry
    {
        type            symmetryPlane;
    }
    holder_walls
    {
        type            externalWallHeatFluxTemperature;
        mode            coefficient;
        kappaMethod	    solidThermo;
        h               uniform 1000;
        Ta              constant $TRef;
        value		    uniform $TRef;
    }
    holder_to_module
    {
	    type            compressible::turbulentTemperatureRadCoupledMixed;
    	kappaMethod	    solidThermo;
	    Tnbr            T;
    	value           uniform $TRef;
    }
}


