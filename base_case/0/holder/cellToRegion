FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/holder";
    object      cellToRegion;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    maxY
    {
        type            zeroGradient;
    }
    minX
    {
        type            symmetryPlane;
    }
    maxX
    {
        type            zeroGradient;
    }
    minY
    {
        type            zeroGradient;
    }
    minZ
    {
        type            zeroGradient;
    }
    maxZ
    {
        type            zeroGradient;
    }
    holder_to_module
    {
        type            calculated;
        value           uniform 0;
    }
    holder_to_lm_cps
    {
        type            calculated;
        value           uniform 0;
    }
}


