FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "system/module";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    h
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
    }
    hFinal
    {
        $h;
        tolerance       1e-8;
        relTol          0;
    }
}

PIMPLE
{
    nNonOrthogonalCorrectors    0;
}

relaxationFactors
{
    equations
    {
        h                       1.0;
    }
}

