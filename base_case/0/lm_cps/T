FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    object      cellToRegion;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

TRef            300;
internalField   uniform $TRef;

boundaryField
{
    lm_cps_top
    {
        type            codedMixed;
        value           uniform $TRef;
        refValue        uniform $TRef;
        refGradient     uniform 0;
        valueFraction   uniform 0;
        name            gaussianHeatFlux;

        codeInclude
        #{
            #include "fvCFD.H"
            #include "basicThermo.H"
        #};

        codeOptions
        #{
            -I$(LIB_SRC)/finiteVolume/lnInclude \
            -I$(LIB_SRC)/thermophysicalModels/basic/lnInclude
        #};

        codeLibs
        #{
            -lfiniteVolume -lfluidThermophysicalModels
        #};

        code
        #{
            const fvPatch& p = patch();
            const fvMesh& mesh = p.boundaryMesh().mesh();
            //const scalar t = this->db().time().value();
            const scalar t = mesh.time().value();
            
            // --- constants ---
            const scalar q0 = 8e6;
            const scalar FWHM = 0.019;
            const scalar a = 4.0*log(2.0)/(FWHM*FWHM);        // = 1/sigma^2
            const scalar x0 = 0.0;
            const scalar y0 = 0.0;
            const scalar k_b = 1.38e-23;                      // Boltzmann constant [m2 kg s-2 K-1]
            const scalar m_li = 1.15e-26;                     // mass of 1 atom of lithium [kg]
            const scalar E_vap_li = 0;                        // latent heat of evaporation of lithium [J]
            const scalar E_sh_li  = 0 * 1.6e-19;              // shielding energy per atom of lithium [J]
            
            // --- ramps ---
            scalar rampUp   = min(t / 7.0, 1.0);
            scalar rampDown = (t <= 17.0) ? 1.0 : max(1.0 - (t - 17.0)/7.0, 0.0);
            scalar qModulated = rampUp*(0.5 + rampUp*0.5) * (0.5 + 0.5*(1 - (rampDown) ) );

            // --- fields ---
            const scalarField Tc(patchInternalField());       // boundary-adjacent cell T
            const vectorField& Cf = p.Cf();

            const basicThermo& thermo =
                mesh.lookupObject<basicThermo>(basicThermo::dictName);
            const scalarField kappap(thermo.kappa(p.index()));

            scalarField& gradField = refGrad();
            scalarField& fracField = valueFraction();
            scalarField& valField  = refValue();

            forAll(gradField, faceI)
            {
                scalar Tcell = Tc[faceI];
                scalar x = Cf[faceI].x();
                scalar y = Cf[faceI].y();

                scalar qFlux =
                    q0 * qModulated
                * exp(-a*(sqr(x - x0) + sqr(y - y0)))
                - pow(10, 10.268 - 15332/Tcell)
                / sqrt(2*constant::mathematical::pi*m_li*k_b*Tcell)
                * (E_vap_li + E_sh_li);

                gradField[faceI] = -qFlux / kappap[faceI];
                fracField[faceI] = 0.0;
                valField[faceI]  = Tcell;   // unused, but keep it sane
            }

            mixedFvPatchScalarField::updateCoeffs();
        #};
    }
    lm_cps_external
    {
        type            externalWallHeatFluxTemperature;
        mode            coefficient;
        h		        uniform 0;	
        Ta		        constant $TRef;
        kappaMethod	    fluidThermo;
        value		    uniform $TRef;
    }
    ".*symmetry"
    {
        type            symmetry;
    }
    lm_cps_to_module
    {
        
        type            compressible::turbulentTemperatureRadCoupledMixed;
        kappaMethod	    fluidThermo;
    	Tnbr            T;
    	value           uniform $TRef;
    }
}


