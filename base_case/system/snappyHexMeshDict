// Which of the steps to run
castellatedMesh true;
snap            false;
addLayers       false;

geometry
{
    holder
    {
        type triSurfaceMesh;
        file "holder.stl";

    }
    module
    {
        type triSurfaceMesh;
        file "module.stl";
    }
    lm_cps
    {
        type triSurfaceMesh;
        file "lm_cps.stl";
    }
}


