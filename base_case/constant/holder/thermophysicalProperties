FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIso;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   64; // Ref: https://webbook.nist.gov/cgi/cbook.cgi?ID=C7440508&Mask=2
    }

    transport
    {
        kappa   395; // Ref: http://hyperphysics.phy-astr.gsu.edu/hbase/Tables/thrcn.html
    }

    thermodynamics
    {
        Hf      0;
        Cp      811; // Ref: https://webbook.nist.gov/cgi/cbook.cgi?ID=C7440508&Mask=2 at 1300K
    }

    equationOfState
    {
        rho     8960;
    }
}

