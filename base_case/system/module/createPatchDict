pointSync   true;

patches
(
    {
        name module_walls;
        patchInfo
        {
            type wall;
        }

        constructFrom patches;
        patches (module_walls module_lm_interface lm_cps_module_interface lm_cps_external module_holder_interface holder_module_interface);
    }
);
