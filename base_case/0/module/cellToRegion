FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/module";
    object      cellToRegion;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    module_symmetry
    {
        type            symmetry;
    }
    module_walls
    {
        type            zeroGradient;
    }
    module_to_holder
    {
        type            calculated;
        value           uniform 0;
    }
    module_to_lm_cps
    {
        type            calculated;
        value           uniform 0;
    }
}


